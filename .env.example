# Polymarket Configuration
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_SECRET=your_secret_here
POLYMARKET_PRIVATE_KEY=your_wallet_private_key_here
CHAIN_ID=137  # Polygon mainnet

# NBA API Configuration
NBA_API_KEY=your_nba_api_key_here  # If using paid tier
NBA_API_BASE_URL=https://api.balldontlie.io/v1

# Trading Configuration
TRADE_SIZE_USDC=5.0
MAX_CONCURRENT_TRADES=3
SLIPPAGE_TOLERANCE=0.02

# Risk Management
STOP_LOSS_PERCENTAGE=2.5
TAKE_PROFIT_PERCENTAGE=3.0
MAX_POSITION_TIME_SECONDS=3600
MIN_LIQUIDITY_USDC=10.0

# Signal Detection
MOMENTUM_RUN_THRESHOLD=8  # Points in a run to trigger signal
LEAD_CHANGE_THRESHOLD=5  # Point swing to consider significant
UPDATE_INTERVAL_SECONDS=3  # How often to check for updates

# Logging
LOG_LEVEL=INFO
LOG_FILE=nba_polymarket_bot.log
