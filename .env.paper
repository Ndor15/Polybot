# Configuration pour PAPER TRADING MODE
# Copie ce fichier vers .env pour commencer : copy .env.paper .env

# ===========================================
# NBA API (OPTIONNEL pour paper mode)
# ===========================================
# Obtiens une clé gratuite sur https://www.balldontlie.io/
# Sans clé, le bot attendra simplement qu'un match commence
# NBA_API_KEY=

# ===========================================
# TRADING SETTINGS (Recommandé pour débuter)
# ===========================================
TRADE_SIZE_USDC=5.0
MAX_CONCURRENT_TRADES=3
SLIPPAGE_TOLERANCE=0.02

# ===========================================
# RISK MANAGEMENT
# ===========================================
STOP_LOSS_PERCENTAGE=2.5
TAKE_PROFIT_PERCENTAGE=3.0
MAX_POSITION_TIME_SECONDS=3600
MIN_LIQUIDITY_USDC=10.0

# ===========================================
# SIGNAL DETECTION
# ===========================================
MOMENTUM_RUN_THRESHOLD=8
LEAD_CHANGE_THRESHOLD=5
UPDATE_INTERVAL_SECONDS=3

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=nba_polymarket_bot.log

# ===========================================
# POUR LIVE TRADING (NE PAS UTILISER MAINTENANT)
# ===========================================
# Décommente ces lignes SEULEMENT si tu passes en mode --live
# POLYMARKET_PRIVATE_KEY=
# CHAIN_ID=137
